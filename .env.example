# Copy to .env; never commit .env or real credentials.
APP_ENV=development
LOG_LEVEL=INFO

# Portal password (any nonempty length). Prefer a unique strong password in .env.
# Do not expose the dashboard publicly; serve on 127.0.0.1 or behind HTTPS + access controls.
DASHBOARD_PASSWORD=
# Backend port for python server.py and the Vite development proxy.
DASHBOARD_PORT=8000

# Video source: 0 = webcam; use RTSP only through a private network/VPN.
VIDEO_SOURCE=0
RTSP_URL=
CAMERA_ID=local-webcam-01

# Detection, tracking, recognition, and unique daily customer counting
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.40
FACE_MODEL=buffalo_l
FACE_MATCH_THRESHOLD=0.45
FACE_GRAY_ZONE_THRESHOLD=0.30
VISITOR_FACE_THRESHOLD=0.42
BODY_MATCH_THRESHOLD=0.84
CUSTOMER_MIN_DWELL_SECONDS=2.5
VISITOR_REENTRY_GAP_SECONDS=30
IDENTITY_CACHE_TTL_SECONDS=60
EMPLOYEE_REFRESH_SECONDS=15

# Change ONLY this number (1-5), then restart the app:
# 1 = current/balanced: 640x480; YOLO 416; face 320; check every 10 frames
# 2 = lighter:          640x480; YOLO 320; face 320; check every 15 frames
# 3 = low:              480x360; YOLO 320; face 256; check every 20 frames
# 4 = very low:         320x240; YOLO 256; face 192; check every 25 frames
# 5 = minimum CPU:      320x240; YOLO 192; face 160; check every 30 frames
# Higher level -> lower CPU load, but weaker detection (especially distant faces).
PERFORMANCE_LEVEL=1
# Optional manual overrides: leave commented to use the selected level.
# CAMERA_WIDTH=640
# CAMERA_HEIGHT=480
# YOLO_IMGSZ=416
# FACE_DET_SIZE=320
# FACE_DETECTION_INTERVAL=10

# ONNX: CoreML is recommended first on Apple Silicon; CPU works everywhere.
# Comma-separated: CoreMLExecutionProvider,CPUExecutionProvider
ONNX_PROVIDERS=CPUExecutionProvider

# Smart Fallback Vision AI (Optional — OpenAI-compatible /chat/completions endpoint)
# Used asynchronously (1 snapshot per unresolved/gray-zone track) to verify staff uniform vs customer clothing.
VISION_AI_ENABLED=auto
VISION_AI_BASE_URL=https://api.openai.com/v1/chat/completions
VISION_AI_API_KEY=
VISION_AI_MODEL=gpt-4o-mini
VISION_AI_STAFF_HINT=Staf klinik QDerma memakai seragam kerja klinik (scrub/tunik medis), jas dokter putih, atau lanyard ID card. Pengunjung/customer memakai pakaian kasual/bebas.

# Select exactly one primary application database: postgresql or mysql.
DATABASE_DRIVER=postgresql
DATABASE_URL=postgresql+psycopg://stafflens:CHANGE_ME@127.0.0.1:5432/stafflens
# MySQL alternative:
# DATABASE_URL=mysql+pymysql://stafflens:CHANGE_ME@127.0.0.1:3306/stafflens

# Object storage (S3-compatible): set only if employee images/event snapshots are uploaded.
STORAGE_ENABLED=false
S3_ENDPOINT_URL=
S3_REGION=ap-southeast-1
S3_BUCKET=stafflens-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=stafflens

# Optional webhook for alerts. Store endpoint secrets only in .env/secret manager.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=
