# Copy to .env; never commit .env or real credentials.
APP_ENV=development
LOG_LEVEL=INFO

# Portal password (any nonempty length). Prefer a unique strong password in .env.
# Do not expose the dashboard publicly; serve on 127.0.0.1 or behind HTTPS + access controls.
DASHBOARD_PASSWORD=
# Backend port for python server.py and the Vite development proxy.
DASHBOARD_PORT=8000

# Video source: 0 = webcam; use RTSP only through a private network/VPN.
VIDEO_SOURCE=0
RTSP_URL=
CAMERA_ID=local-webcam-01

# Detection, tracking, recognition, and unique daily customer counting
# YOLO_MODEL: yolox_nano.onnx, yolox_tiny.onnx, or yolox_s.onnx (Apache-2.0 YOLOX ONNX Runtime)
YOLO_MODEL=yolox_nano.onnx
# YOLO_DEVICE: '' = Ultralytics default (CUDA if present else CPU), 'auto' = cuda->mps->cpu, or explicit device
YOLO_DEVICE=auto
# ONNX_PROVIDERS: comma-separated. CoreMLExecutionProvider requires ONNX model. CPU is always fallback.
ONNX_PROVIDERS=CoreMLExecutionProvider,CPUExecutionProvider
# FACE_MODEL: sface (OpenCV Zoo YuNet + SFace 128-d, Apache-2.0 commercial-free)
FACE_MODEL=sface
# FACE_ALLOWED_MODULES: comma-separated (detection,recognition) or 'all'
FACE_ALLOWED_MODULES=detection,recognition
# CAMERA_THREADED: 0=blocking read, 1=background thread (always fresh frame, drop stale)
CAMERA_THREADED=1
YOLO_CONFIDENCE=0.40
FACE_MATCH_THRESHOLD=0.45
FACE_GRAY_ZONE_THRESHOLD=0.30
VISITOR_FACE_THRESHOLD=0.42
BODY_MATCH_THRESHOLD=0.84
CUSTOMER_MIN_DWELL_SECONDS=2.5
VISITOR_REENTRY_GAP_SECONDS=30
IDENTITY_CACHE_TTL_SECONDS=60
EMPLOYEE_REFRESH_SECONDS=15

# Change ONLY this number (1-5), then restart the app:
# 1 = current/balanced: 640x480; YOLO 416; face 320; check every 10 frames
# 2 = lighter:          640x480; YOLO 320; face 320; check every 15 frames
# 3 = low:              480x360; YOLO 320; face 256; check every 20 frames
# 4 = very low:         320x240; YOLO 256; face 192; check every 25 frames
# 5 = minimum CPU:      320x240; YOLO 192; face 160; check every 30 frames
# Higher level -> lower CPU load, but weaker detection (especially distant faces).
PERFORMANCE_LEVEL=1
# Optional manual overrides: leave commented to use the selected level.
# CAMERA_WIDTH=640
# CAMERA_HEIGHT=480
# YOLO_IMGSZ=416
# FACE_DET_SIZE=320
# FACE_DETECTION_INTERVAL=10

# Preview stream config (for dashboard live feed, not main detection)
# PREVIEW_MAX_FPS: throttle preview to N fps (0=no throttle). Dashboard still runs at full rate.
PREVIEW_MAX_FPS=8
# PREVIEW_MAX_WIDTH: downscale width before JPEG (0=no downscale). Saves bandwidth, not detection cost.
PREVIEW_MAX_WIDTH=0
# PREVIEW_JPEG_QUALITY: 1-100. Lower = smaller size, more artifacts. 65 is a good balance.
PREVIEW_JPEG_QUALITY=65

# DB_ASYNC_WRITES: 0=blocking, 1=background queue (non-returning writes for visitor/log updates)
DB_ASYNC_WRITES=1

# Smart Fallback Vision AI (Optional — OpenAI-compatible /chat/completions endpoint)
# Used asynchronously (1 snapshot per unresolved/gray-zone track) to verify staff uniform vs customer clothing.
VISION_AI_ENABLED=auto
VISION_AI_BASE_URL=https://api.openai.com/v1/chat/completions
VISION_AI_API_KEY=
VISION_AI_MODEL=gpt-4o-mini
# Request timeout in seconds; clamped to 120-300. Default 120 (2 minutes).
VISION_AI_TIMEOUT_SECONDS=30
CUSTOMER_SNAPSHOT_DIR=customer_snapshots/temp
SNAPSHOT_RETENTION_SECONDS=86400
VISION_AI_STAFF_HINT=Staf klinik QDerma memakai seragam kerja klinik (scrub/tunik medis), jas dokter putih, atau lanyard ID card. Pengunjung/customer memakai pakaian kasual/bebas.

# Select exactly one primary application database: postgresql or mysql.
DATABASE_DRIVER=postgresql
DATABASE_URL=postgresql+pg8000://stafflens:CHANGE_ME@127.0.0.1:5432/stafflens
# MySQL alternative:
# DATABASE_URL=mysql+pymysql://stafflens:CHANGE_ME@127.0.0.1:3306/stafflens

# Object storage (S3-compatible): set only if employee images/event snapshots are uploaded.
STORAGE_ENABLED=false
S3_ENDPOINT_URL=
S3_REGION=ap-southeast-1
S3_BUCKET=stafflens-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=stafflens

# Optional webhook for alerts. Store endpoint secrets only in .env/secret manager.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=

# SatuSehat (Kemenkes) integration.
# Client ID, Client Secret, Organization ID, and active environment are NOT set here:
# they are entered from the dashboard (Pengaturan > Integrasi SatuSehat) and stored in the database.
# Only the non-secret base URLs and the encryption master key live in .env.
SATUSEHAT_BASE_URL_DEV=https://api-satusehat-dev.dto.kemkes.go.id
SATUSEHAT_BASE_URL_STAGING=https://api-satusehat-stg.dto.kemkes.go.id
SATUSEHAT_BASE_URL_PRODUCTION=https://api-satusehat.kemkes.go.id
# Master key (Fernet, 32 url-safe base64 bytes) that encrypts the Client Secret in the database.
# Generate: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it outside the database. If lost, the Client Secret must be re-entered.
SATUSEHAT_ENCRYPTION_KEY=
